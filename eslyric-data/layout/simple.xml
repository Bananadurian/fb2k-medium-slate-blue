<?xml version="1.0" encoding="UTF-8"?>
<layout xmlns="https://github.com/ESLyric/layout"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/ESLyric/layout ./Layout.xsd">
    <panel name="simple"
           layout="stack"
           orientation="vertical"
           features="1">
        
        <!-- 优化：增加 layout="free" 声明，并清理不规范的 % 边距写法 -->

        
        <!-- 优化：bottom-panel 删除冗余且冲突的 anchor="vfill" (已有 height="*" 控制空间) -->
        <container name="bottom-panel"
                   layout="stack"
                   orientation="vertical"
                   width="100%"
                   height="*"
                   margin="0,0,0,0"
                   justify="start"
                   visibility="1">
            

            
            <!-- 优化：使用 height="*" 完美填充剩余空白区域，并删除冗余的 anchor="fill" -->
            <lyric width="100%"
                   height="*"
                   margin="2%,2%,2%,2%"
                   text-align="center"
                   banner-text="foobar2000" 
                   visibility="0"/>
            

        </container>
    </panel>
</layout>